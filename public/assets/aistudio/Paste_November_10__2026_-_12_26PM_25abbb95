            /* ------------------------- Scaling system -------------------------------------------------- */
 
/* Desktop */
:root {
  --size-unit: 16;
  /* Body font-size in design — no px */
 
  --size-container-ideal: 1920;
  /* Screen width in design — no px */
 
  --size-container-min: 992px;
  --size-container-max: 3840px;
  /* Absolute maximum container width */
 
  --size-container-fluid: 100dvw;
 
  --size-container: clamp(var(--size-container-min),
      var(--size-container-fluid),
      var(--size-container-max));
 
  --size-font: calc(var(--size-container) / (var(--size-container-ideal) / var(--size-unit)));
 
  /* Container scale factors */
  --container-medium-scale: 0.85;
  --container-small-scale: 0.7;
 
  --vh: 1vh;
  /* Fallback before JS runs */
 
  --near-screen-height: 80dvh;
  --full-screen-height: 100dvh;
  --over-screen-height: 120dvh;
  --double-screen-height: 200dvh;
  --xxl-screen-height: 250dvh;
}
 
/*
  Ultrawide desktop viewports only.
 
  11 / 5 = 2.2:1 activation threshold.
  Once activated, the design canvas is capped to 16:9
  based on the available viewport height.
*/
@media screen and (min-width: 992px) and (min-aspect-ratio: 11/5) {
  :root {
    --size-container-fluid: min(100dvw,
        calc(100dvh * 16 / 9));
  }
}
 
/* Tablet */
@media screen and (max-width: 991px) {
  :root {
    --size-container-ideal: 991;
    /* Screen width in design — no px */
 
    --size-container-min: 768px;
    --size-container-max: 991px;
    --size-container-fluid: 100dvw;
 
    --container-medium-scale: 0.9;
    --container-small-scale: 0.8;
 
    --near-screen-height: calc(var(--vh) * 80);
    --full-screen-height: calc(var(--vh) * 100);
